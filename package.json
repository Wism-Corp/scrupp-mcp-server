{
  "name": "scrupp-mcp-server",
  "version": "0.3.0",
  "description": "MCP server for Scrupp — export LinkedIn, Sales Navigator and Apollo searches, get LinkedIn post engagers, find local businesses on Google Maps, watch people and companies for job changes, find decision makers, and find and verify work emails",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "scrupp",
    "linkedin",
    "sales-navigator",
    "apollo",
    "lead-generation",
    "email-finder",
    "google-maps",
    "signals",
    "job-changes"
  ],
  "license": "MIT",
  "homepage": "https://scrupp.com/docs/api/integrations-jobs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wism-Corp/scrupp-mcp-server.git"
  },
  "type": "module",
  "bin": {
    "scrupp-mcp-server": "src/index.js",
    "scrupp-mcp": "src/index.js",
    "scrupp-mcp-http": "src/http.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js"
  },
  "files": [
    "src",
    "server.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.wismhero-maker/scrupp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.0"
  }
}
